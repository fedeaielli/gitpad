# Maintainer: GitPad contributors

pkgname=gitpad
pkgver=1.4.1
pkgrel=1
pkgdesc="Markdown notes in a Git repository"
arch=('x86_64')
url="https://github.com/fedeaielli/gitpad"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libsecret' 'openssl' 'dbus' 'xdg-utils')
makedepends=('cargo' 'rust' 'nodejs' 'npm' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/fedeaielli/gitpad/archive/v$pkgver.tar.gz")
sha256sums=('5f7b4313fe8ed8674bfa4d14ea540b6d53e68a28bfe597eb211cf53ec1a60ae5')

prepare() {
  cd "$pkgname-$pkgver"
  npm ci
}

build() {
  cd "$pkgname-$pkgver"
  npm run build
  # custom-protocol embeds the frontend in the binary, like `tauri build` does.
  cargo build --release --locked --features tauri/custom-protocol \
    --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 src-tauri/target/release/gitpad "$pkgdir/usr/bin/gitpad"
  install -Dm644 src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/gitpad.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/gitpad.png"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/gitpad.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/gitpad.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=GitPad
Comment=Markdown notes in a Git repository
Exec=gitpad
Icon=gitpad
Categories=Utility;TextEditor;
Terminal=false
EOF
}
